{
  "manifest_version": 3,
  "name": "Canvas Messenger",
  "version": "1.9.0",
  "description": "Discord-style messaging for Canvas \u2014 chat with students and professors directly.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "styles/messenger.js",
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "token-setup.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Canvas Messenger"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "styles/messenger.css",
        "call.html",
        "call.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "canvas-messenger@hackatoa",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  }
}
