{
  "manifest_version": 3,
  "name": "Canvas Messenger",
  "version": "1.11.1",
  "key": "",
  "description": "Discord-style messaging for Canvas \u2014 chat with students and professors directly.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "styles/messenger.js",
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "token-setup.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Canvas Messenger"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "styles/messenger.css",
        "call.html",
        "call.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
